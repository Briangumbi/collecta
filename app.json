{
  "expo": {
    "name": "ledger",
    "slug": "ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ledger",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.ledgerapp.client",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Ledger uses Face ID to quickly and securely unlock your dashboard.",
        "NSCameraUsageDescription": "Ledger uses your camera to scan and attach receipts to projects.",
        "NSPhotoLibraryUsageDescription": "Ledger lets you attach photos from your library to projects and receipts."
      }
    },
    "android": {
      "package": "dev.ledgerapp.client",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Ledger uses your camera to scan and attach receipts to projects."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ledger lets you attach photos from your library to projects and receipts."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ledger uses Face ID to quickly and securely unlock your dashboard."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#208AEF"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d337eb4-4ada-4849-a339-87c63866f437"
      }
    },
    "owner": "brian101"
  }
}
